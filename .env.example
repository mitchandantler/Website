# Copy this file to .env and fill in real values.
# .env is never committed to Git — see docs/phase-00-foundation/06-security.md

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to use SQLite. Example for PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/mitchandantler

TIME_ZONE=Australia/Sydney

# Resend (email) — see docs/phase-01-website/07-integrations.md
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@mitchandantler.com
CONTACT_NOTIFICATION_EMAIL=
